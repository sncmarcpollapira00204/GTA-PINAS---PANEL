# GTA Pinas Web Panel

# Shared PostgreSQL database used by GTA-Pinas-Bot and the Web Panel.
DATABASE_URL=

# Discord bot token used by the Web Panel for Discord API/profile lookups.
DISCORD_TOKEN=

# Discord OAuth2 application credentials for Web Panel login.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://YOUR-WEB-PANEL-DOMAIN/auth/discord/callback

# GTA Pinas Discord server.
DISCORD_GUILD_ID=1525392083924549682

# Panel access control. Use role IDs and/or specific Discord user IDs.
PANEL_ALLOWED_ROLE_IDS=
PANEL_ALLOWED_USER_IDS=

# Session security.
SESSION_SECRET=
COOKIE_SECURE=true
NODE_ENV=production
SESSION_HOURS=8
ACCESS_RECHECK_MINUTES=10

# Optional public URL used when the OAuth callback cannot be inferred.
PUBLIC_URL=

# Optional persistent media storage. Leave blank to store uploads in PostgreSQL.
MEDIA_STORAGE_DIR=
